---
import '../styles/global.css';
import '@fontsource/newsreader/latin-500.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/newsreader/latin-500-italic.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import { sectionIds, sectionMeta, type SectionId } from '../lib/catalog';

interface Props {
  title: string;
  description: string;
  section?: SectionId;
}

const { title, description, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogTitle =
  title === 'Week in Omarchy' ? title : `${title} · Week in Omarchy`;
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Week in Omarchy"
      href="/rss.xml"
    />
    <meta property="og:site_name" content="Week in Omarchy" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body
    class:list={{
      'page-home': title === 'Week in Omarchy',
      'page-inner': title !== 'Week in Omarchy',
    }}
  >
    <a class="skip" href="#content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="shell">
        <div class="edition-line">
          <span>An independent Omarchy field guide</span>
          <a href="https://github.com/tcballard/weekinomarchy">
            Source & contributions <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="mast">
          <a class="brand" href="/" aria-label="Week in Omarchy — home">
            <span class="brand-prefix">Week in</span>
            <span class="brand-title">
              Omarchy<span class="brand-period">.</span>
            </span>
          </a>
          <p class="mast-note">
            News, themes & useful things
            <br />
            for a desktop of your own.
          </p>
        </div>
        <div class="navigation-line">
          <nav class="nav" aria-label="Sections">
            {sectionIds.map((id) => (
              <a
                href={`/${id}/`}
                aria-current={section === id ? 'page' : undefined}
              >
                {sectionMeta[id].title}
              </a>
            ))}
          </nav>
          <form
            class="search"
            action="/search/"
            method="get"
            role="search"
            aria-label="Sitewide search"
          >
            <label class="sr-only" for="site-search">
              Search
            </label>
            <input
              id="site-search"
              type="search"
              name="q"
              placeholder="Find something…"
            />
            <button type="submit" aria-label="Search the guide">
              Search <span aria-hidden="true">↗</span>
            </button>
          </form>
        </div>
      </div>
    </header>
    <main id="content" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-top">
          <a class="footer-brand" href="/">
            Week in <em>Omarchy.</em>
          </a>
          <div class="footer-links">
            <a href="/sponsor/">Sponsorship</a>
            <a href="/rss.xml">RSS feed</a>
            <a href="https://github.com/tcballard/weekinomarchy">
              Contribute ↗
            </a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>
            An independent guide. Not affiliated with Omarchy or the Omacom
            Foundation.
          </p>
          <p>Built from the community. Linked to the source.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
