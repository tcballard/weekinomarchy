---
import Base from '@layouts/Base.astro';
import { cardsFor, sectionIds, sectionMeta, type SectionId } from '@lib/catalog';

export async function getStaticPaths() {
  return sectionIds.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionId;
const meta = sectionMeta[section];
const cards = await cardsFor(section);
const filterable = section === 'themes' || section === 'tools';
const categories = [...new Set(cards.flatMap((card) => (card.category ? [card.category] : [])))].sort((a, b) =>
  a.localeCompare(b),
);
const recentSince = cards.find((card) => card.recentSince)?.recentSince;
---

<Base title={meta.title} description={meta.lede} section={section}>
  <p class="kicker">Section</p>
  <h1 style="font-size: clamp(2.4rem, 5vw, 3.4rem); margin: 0.2rem 0 0.6rem;">{meta.title}</h1>
  <p class="lede">{meta.lede}</p>
  <p class="note">{meta.note}</p>
  {
    filterable && (
      <div class="filters" data-filters>
        {section === 'themes' && (
          <>
            <div class="filter-row" role="group" aria-label="Mode">
              <button type="button" data-key="mode" data-value="all" aria-pressed="true">
                All modes
              </button>
              <button type="button" data-key="mode" data-value="dark">
                Dark
              </button>
              <button type="button" data-key="mode" data-value="light">
                Light
              </button>
            </div>
            <div class="filter-row" role="group" aria-label="Source">
              <button type="button" data-key="gallery" data-value="all" aria-pressed="true">
                All listed themes
              </button>
              <button type="button" data-key="gallery" data-value="true">
                Manual gallery
              </button>
              <button type="button" data-key="gallery" data-value="false">
                Not captioned
              </button>
            </div>
          </>
        )}
        {section === 'tools' && (
          <>
            <div class="filter-row" role="group" aria-label="Category">
              <button type="button" data-key="category" data-value="all" aria-pressed="true">
                All categories
              </button>
              {categories.map((category) => (
                <button type="button" data-key="category" data-value={category}>
                  {category}
                </button>
              ))}
            </div>
            {recentSince && (
              <div class="filter-row" role="group" aria-label="Listed date">
                <button type="button" data-key="recent" data-value="all" aria-pressed="true">
                  Any listed date
                </button>
                <button type="button" data-key="recent" data-value="true">
                  Listed since {recentSince}
                </button>
              </div>
            )}
          </>
        )}
        <p id="filter-status" class="note">
          Filters run in this browser.
        </p>
      </div>
    )
  }
  <div class="card-grid" style="margin-top: 1.4rem;">
    {
      cards.map((card) => (
        <article
          class="card"
          data-card
          data-mode={card.mode}
          data-gallery={card.gallery === undefined ? undefined : String(card.gallery)}
          data-category={card.category}
          data-recent={card.recent === undefined ? undefined : String(card.recent)}
        >
          {card.preview && (
            <a class="card-shot" href={card.href}>
              <img src={card.preview.src} alt={card.preview.alt} />
            </a>
          )}
          {card.swatches && (
            <div class="swatches" aria-hidden="true">
              {card.swatches.map((hex) => (
                <span class="swatch" style={`background:${hex}`} />
              ))}
            </div>
          )}
          <p class="meta">{card.meta}</p>
          <h3>
            <a class="title" href={card.href}>
              {card.title}
            </a>
          </h3>
          <p class="summary">{card.summary}</p>
        </article>
      ))
    }
  </div>
  {section === 'tools' && (
    <p class="note" style="margin-top: 1.2rem;">
      Install commands come from the catalog. The manual’s shell plugins chapter is at{' '}
      <a href="https://omarchy.org/manual/shell-plugins/">omarchy.org/manual/shell-plugins</a>.
    </p>
  )}
  {
    filterable && (
      <noscript>
        <p class="note">Every listing is shown above. The filters need JavaScript.</p>
      </noscript>
    )
  }
  <script>
    const root = document.querySelector<HTMLElement>('[data-filters]');
    if (root) {
      const status = document.querySelector<HTMLElement>('#filter-status');
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-key]')];
      const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
      const selected = new Map<string, string>();

      function apply() {
        let shown = 0;
        for (const card of cards) {
          let ok = true;
          for (const [key, value] of selected) {
            if (value !== 'all' && card.getAttribute(`data-${key}`) !== value) ok = false;
          }
          card.hidden = !ok;
          if (ok) shown += 1;
        }
        if (status) {
          status.textContent =
            shown === cards.length ? `Showing all ${cards.length}` : `Showing ${shown} of ${cards.length}`;
        }
      }

      for (const button of buttons) {
        if (button.getAttribute('aria-pressed') === 'true' && button.dataset.key && button.dataset.value) {
          selected.set(button.dataset.key, button.dataset.value);
        }
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const key = button.dataset.key;
          const value = button.dataset.value;
          if (!key || !value) return;
          for (const other of buttons) {
            if (other.dataset.key === key) other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
          }
          selected.set(key, value);
          apply();
        });
      }

      apply();
    }
  </script>
</Base>
